{
  "manifest_version": "0.2",
  "name": "shopware-mcp",
  "display_name": "Shopware",
  "version": "0.6.0",
  "description": "Query and safely manage your Shopware 6 shop: products, orders, customers, stock, documents, health audits and sales reports.",
  "long_description": "Connects your AI assistant to the Shopware 6 Admin API. Read-only by default; write tools (stock, product basics and new products, order, delivery and payment state, internal notes, documents, promotions and promotion codes, customer accounts, review moderation) can be enabled and always default to a dry run, with an optional write budget. Includes a one-shot shop health audit, sales and customer reports with period comparison, order history, order documents as PDF and schema-aware access to any Shopware entity with credentials stripped.",
  "author": {
    "name": "bnymnDev",
    "url": "https://github.com/bnymnDev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bnymnDev/shopware-mcp"
  },
  "homepage": "https://github.com/bnymnDev/shopware-mcp",
  "documentation": "https://github.com/bnymnDev/shopware-mcp/blob/main/docs/quickstart.md",
  "support": "https://github.com/bnymnDev/shopware-mcp/issues",
  "license": "MIT",
  "keywords": [
    "shopware",
    "ecommerce",
    "shop",
    "orders",
    "products",
    "admin-api",
    "documents",
    "invoices",
    "mcp"
  ],
  "server": {
    "type": "node",
    "entry_point": "dist/bundle/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/bundle/index.js"
      ],
      "env": {
        "SHOPWARE_URL": "${user_config.shopware_url}",
        "SHOPWARE_CLIENT_ID": "${user_config.client_id}",
        "SHOPWARE_CLIENT_SECRET": "${user_config.client_secret}",
        "SHOPWARE_MCP_ALLOW_WRITE": "${user_config.allow_write}",
        "SHOPWARE_MCP_MAX_WRITES": "${user_config.max_writes}"
      }
    }
  },
  "user_config": {
    "shopware_url": {
      "type": "string",
      "title": "Shop URL",
      "description": "Base URL of your shop, e.g. https://shop.example.com",
      "required": true
    },
    "client_id": {
      "type": "string",
      "title": "Integration access key ID",
      "description": "Admin → Settings → System → Integrations",
      "required": true
    },
    "client_secret": {
      "type": "string",
      "title": "Integration secret access key",
      "description": "Shown once when the integration is created",
      "required": true,
      "sensitive": true
    },
    "allow_write": {
      "type": "boolean",
      "title": "Enable write tools",
      "description": "Registers the guarded write tools: stock, product basics, order state, shipping with tracking codes, payment state, internal notes, documents and promotions. Every write defaults to a dry run.",
      "required": false,
      "default": false
    },
    "max_writes": {
      "type": "number",
      "title": "Write budget",
      "description": "Real writes this extension may perform per session; 0 means no cap. Dry runs are always free.",
      "required": false,
      "default": 0,
      "min": 0,
      "max": 1000000
    }
  },
  "tools": [
    {
      "name": "shop_info",
      "description": "Shop info"
    },
    {
      "name": "shop_settings",
      "description": "Shop settings"
    },
    {
      "name": "sales_channels_list",
      "description": "List sales channels"
    },
    {
      "name": "products_search",
      "description": "Search products"
    },
    {
      "name": "products_get",
      "description": "Get product"
    },
    {
      "name": "orders_search",
      "description": "Search orders"
    },
    {
      "name": "orders_get",
      "description": "Get order"
    },
    {
      "name": "order_history",
      "description": "Order history"
    },
    {
      "name": "order_documents_list",
      "description": "List order documents"
    },
    {
      "name": "document_download",
      "description": "Download document PDF"
    },
    {
      "name": "customers_search",
      "description": "Search customers"
    },
    {
      "name": "customers_get",
      "description": "Get customer"
    },
    {
      "name": "categories_list",
      "description": "List categories"
    },
    {
      "name": "promotions_list",
      "description": "List promotions"
    },
    {
      "name": "reviews_search",
      "description": "Search product reviews"
    },
    {
      "name": "payment_methods_list",
      "description": "List payment methods"
    },
    {
      "name": "shipping_methods_list",
      "description": "List shipping methods"
    },
    {
      "name": "plugins_list",
      "description": "List plugins and apps"
    },
    {
      "name": "scheduled_tasks_list",
      "description": "Scheduled tasks"
    },
    {
      "name": "stock_get",
      "description": "Get stock"
    },
    {
      "name": "stock_forecast",
      "description": "Stock forecast"
    },
    {
      "name": "sales_report",
      "description": "Sales report"
    },
    {
      "name": "customer_report",
      "description": "Customer report"
    },
    {
      "name": "shop_audit",
      "description": "Shop health audit"
    },
    {
      "name": "entity_schema",
      "description": "Entity schema"
    },
    {
      "name": "entity_search",
      "description": "Search any entity"
    },
    {
      "name": "stock_set",
      "description": "Set stock (guarded)"
    },
    {
      "name": "product_update",
      "description": "Update product (guarded)"
    },
    {
      "name": "product_create",
      "description": "Create product (guarded)"
    },
    {
      "name": "product_cover_set",
      "description": "Set product cover image (guarded)"
    },
    {
      "name": "order_state_transition",
      "description": "Transition order state (guarded)"
    },
    {
      "name": "order_delivery_transition",
      "description": "Transition delivery state (guarded)"
    },
    {
      "name": "order_transaction_transition",
      "description": "Transition payment state (guarded)"
    },
    {
      "name": "order_note",
      "description": "Add internal order note (guarded)"
    },
    {
      "name": "order_document_create",
      "description": "Create order document (guarded)"
    },
    {
      "name": "order_documents_bulk_create",
      "description": "Create documents for many orders (guarded)"
    },
    {
      "name": "promotion_toggle",
      "description": "Toggle promotion (guarded)"
    },
    {
      "name": "promotion_create",
      "description": "Create promotion (guarded)"
    },
    {
      "name": "customer_update",
      "description": "Update customer (guarded)"
    },
    {
      "name": "review_moderate",
      "description": "Moderate review (guarded)"
    },
    {
      "name": "tag_assign",
      "description": "Assign tags (guarded)"
    }
  ],
  "tools_generated": false,
  "prompts": [
    {
      "name": "order_summary",
      "description": "Summarize one order for a support reply",
      "arguments": [
        "orderNumber"
      ],
      "text": "Load order ${arguments.orderNumber} with orders_get and write a short, friendly support summary: date, items, total, payment and delivery state, tracking codes and shipping address. Flag anything that looks stuck."
    },
    {
      "name": "low_stock_report",
      "description": "List active products below a stock threshold",
      "arguments": [
        "threshold"
      ],
      "text": "Use products_search with a range filter stock < ${arguments.threshold} and active = true, includeVariants = true, sorted by stock ascending. Produce a table with product number, name, stock, available stock and manufacturer, and end with the total count."
    }
  ],
  "prompts_generated": false,
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=22.0.0"
    }
  }
}
