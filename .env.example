# Required
SHOPWARE_URL=https://shop.example.com
SHOPWARE_CLIENT_ID=SWIA...
SHOPWARE_CLIENT_SECRET=...

# Optional
SHOPWARE_MCP_ALLOW_WRITE=false
SHOPWARE_MCP_DEFAULT_LIMIT=20
SHOPWARE_MCP_LOG_LEVEL=error
# SHOPWARE_MCP_MAX_WRITES=0          # real writes per process, 0 = no cap
# SHOPWARE_MCP_EXTENSIONS=true       # false disables plugin-aware tools
# SHOPWARE_MCP_TIMEOUT_MS=30000      # per-request timeout for the Admin API
# SHOPWARE_MCP_HTTP_TOKEN=           # bearer token for --http, at least 16 characters
# SHOPWARE_LANGUAGE_ID=              # language UUID for translated fields
